# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicitly declare text files that should always use LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.mdx  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.html text eol=lf
*.env  text eol=lf
*.toml text eol=lf
*.lock text eol=lf -diff

# Binary files - do not modify
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.mp4  binary
*.webp binary
