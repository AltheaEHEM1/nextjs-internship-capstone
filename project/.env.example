# Next.js Configuration
# Copy this file to .env.local and fill in your values
# Run: cp .env.example .env.local

# ============================================
# CLERK AUTHENTICATION
# ============================================
# Get your keys from https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Clerk URLs (update these after deploying)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# ============================================
# DATABASE
# ============================================
# Option 1: Neon Database
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require&uselibpqcompat=true

# Option 2: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/projectflow

# ============================================
# APPLICATION URL
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# PUSHER (Real-time)
# ============================================
PUSHER_APP_ID=your_pusher_app_id
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# ============================================
# EMAIL CONFIGURATION (SMTP via Nodemailer)
# ============================================
# This is the shared app-level SMTP account used to deliver emails.
# It is NOT tied to any individual user — each invitation email
# dynamically shows the inviter's name and reply-to address.
#
# Using Gmail with App Passwords:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Paste the 16-character password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=projectnify.noreply@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=projectnify.noreply@gmail.com

# ============================================
# NOTES
# ============================================
# - Never commit .env.local to git (it's in .gitignore)
# - Store sensitive keys securely
# - Use different keys for development and production
# - Get production keys from your team lead during deployment phase
